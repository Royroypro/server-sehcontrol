HOST=127.0.0.1
PORT=8899
JWT_SECRET=GENERAR_UN_SECRETO_ALEATORIO

DEFAULT_ADMIN_EMAIL=admin@sehuacho.com
DEFAULT_ADMIN_PASSWORD=DEFINIR_DIRECTAMENTE_EN_PRODUCCION

COOKIE_SECURE=true
FORCE_LOGIN=true

# Sesión del cliente nativo Sehcontrol. Se extiende mientras el equipo siga
# utilizándola; el panel web conserva su cookie JWT independiente de 12 horas.
NATIVE_SESSION_TTL_DAYS=90
NATIVE_SESSION_TOUCH_INTERVAL_HOURS=24

CLIENT_EXE_MAX_MB=500
CLIENT_APK_MAX_MB=500

RUSTDESK_RELAY_HOST=sehcontrol.sehuacho.com

SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
