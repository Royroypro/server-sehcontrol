HOST=127.0.0.1
PORT=8899
JWT_SECRET=GENERAR_UN_SECRETO_ALEATORIO

DEFAULT_ADMIN_EMAIL=admin@sehuacho.com
DEFAULT_ADMIN_PASSWORD=DEFINIR_DIRECTAMENTE_EN_PRODUCCION

COOKIE_SECURE=true
FORCE_LOGIN=true
CLIENT_EXE_MAX_MB=500
CLIENT_APK_MAX_MB=500

RUSTDESK_RELAY_HOST=sehcontrol.sehuacho.com

# Previsualizacion de ScreenCam (gateway multimedia). Si se dejan vacias, la
# funcion queda deshabilitada de forma limpia: el panel responde 503 al pedir
# una previsualizacion y todo lo demas sigue funcionando igual.
# MEDIA_PUBLISH_URL  -> a donde publica el cliente (SRT, saliente).
# MEDIA_PLAYBACK_BASE-> base publica del WHEP/WebRTC que consume el navegador.
MEDIA_PUBLISH_URL=srt://sehcontrol.sehuacho.com:8890
MEDIA_PLAYBACK_BASE=https://sehcontrol.sehuacho.com/media

SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
